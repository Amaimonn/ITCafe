    },
    "m_SourceType": 1,
    "m_FunctionName": "BulgeEffect_float",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 dir = UV - TouchPoint;\nfloat dist = length(dir);\nfloat falloff = exp(-dist * Falloff);\nfloat strength = BulgeAmount * falloff;\n OutUV = UV - dir * strength;"
}

