.order-preview__food-name {
    margin-right: 2px;
    margin-bottom: 0;
    margin-left: 2px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    height: 32px;
    font-size: 14px;
    -unity-text-align: middle-left;
    margin-top: 0;
    color: rgb(255, 245, 200);
}

.order-preview__image {
    width: 32px;
    height: 32px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
}

.order-preview__food-container {
    width: 100%;
}

.order-preview__food-item {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
}
