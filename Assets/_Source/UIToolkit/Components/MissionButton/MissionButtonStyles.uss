.campaign__mission-button {
    width: 80px;
    height: 80px;
    border-radius: 3px;
    background-color: rgb(30, 35, 50);
    border-color: rgb(70, 170, 200);
    border-width: 2px;
    font-size: 20px;
    color: rgb(180, 220, 210);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    justify-content: center;
    rotate: 45deg;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

.campaign__mission-button:hover {
    background-color: rgb(40, 45, 65);
    border-color: rgb(100, 200, 230);
}

.campaign__mission-button:active {
    background-color: rgb(50, 55, 80);
    border-color: rgb(120, 220, 255);
}

.campaign__mission-button.selected {
    background-color: rgb(20, 40, 60);
    border-color: rgb(0, 184, 148);
    border-width: 4px;
    scale: 1.05 1.05;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.campaign__mission-button.selected:hover {
    background-color: rgb(20, 40, 60);
    border-color: rgb(0, 184, 148);
    border-width: 4px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.campaign__mission-button.selected:active {
    background-color: rgb(20, 40, 60);
    border-color: rgb(0, 184, 148);
    border-width: 4px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.campaign__mission-button.locked {
    background-color: rgb(40, 45, 60);
    border-color: rgb(80, 90, 110);
    color: rgb(120, 130, 150);
}

.campaign__mission-button.locked:hover {
    background-color: rgb(45, 50, 65);
    border-color: rgb(90, 100, 120);
    color: rgb(130, 140, 160);
}

.campaign__mission-button.locked:active {
    background-color: rgb(50, 55, 70);
    border-color: rgb(100, 110, 130);
    color: rgb(140, 150, 170);
}

.campaign__mission-button.locked.selected {
    background-color: rgb(35, 40, 55);
    border-color: rgb(60, 70, 90);
    color: rgb(110, 120, 140);
}

.campaign__mission-button.locked.selected:hover {
    background-color: rgb(35, 40, 55);
    border-color: rgb(60, 70, 90);
    color: rgb(110, 120, 140);
}

.campaign__mission-button.locked.selected:active {
    background-color: rgb(35, 40, 55);
    border-color: rgb(60, 70, 90);
    color: rgb(110, 120, 140);
}

.campaign__mission-button.completed {
    background-color: rgb(20, 50, 40);
    border-color: rgb(46, 204, 113);
}

.campaign__mission-button.completed:hover {
    background-color: rgb(25, 60, 45);
    border-color: rgb(56, 214, 123);
}

.campaign__mission-button.completed:active {
    background-color: rgb(30, 70, 50);
    border-color: rgb(66, 224, 133);
}

.campaign__mission-button.completed.selected {
    background-color: rgb(15, 45, 35);
    border-color: rgb(36, 194, 103);
}

.campaign__mission-button.completed.selected:hover {
    background-color: rgb(15, 45, 35);
