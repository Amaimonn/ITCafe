.mission__stars {
    -unity-text-align: middle-center;
    margin-top: 4px;
    justify-content: center;
    padding-left: 3px;
    height: 11px;
    max-height: 11px;
    flex-direction: row;
}

.campaign__stars-container {
    flex-direction: row;
    margin-bottom: 15px;
}

.campaign__stat-star {
    width: 20px;
    height: 20px;
    background-color: rgb(255, 184, 0);
    border-radius: 50%;
    margin-left: 4px;
    margin-right: 4px;
}

.campaign__stat-star--empty {
    background-color: rgb(60, 70, 90);
    opacity: 0.5;
}

.campaign__mission-stars {
    flex-direction: row;
    -unity-text-align: middle-center;
    margin-top: 4px;
    justify-content: center;
    padding-left: 3px;
    height: 11px;
    position: absolute;
    bottom: 0;
}

.campaign__mission-star {
    width: 11px;
    height: 11px;
    margin-right: 3px;
    border-radius: 50%;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    background-image: url("project://database/Assets/_Source/Art/Images/star_symbol.png?fileID=2800000&guid=de123aa9100e11242867f0d24f722d05&type=3#star_symbol");
    -unity-background-image-tint-color: rgb(255, 215, 0);
    flex-shrink: 0;
}

.mission__display {
}

.mission__wrapper {
    flex-grow: 0;
    align-self: flex-start;
    align-items: center;
}

.campaign__mission-wrapper {
