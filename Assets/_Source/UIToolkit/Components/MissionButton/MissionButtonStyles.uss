}

.campaign__mission-button.completed.selected:active {
    background-color: rgb(15, 45, 35);
    border-color: rgb(36, 194, 103);
}

.campaign__mission-number {
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    rotate: -45deg;
}

.mission__number {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
