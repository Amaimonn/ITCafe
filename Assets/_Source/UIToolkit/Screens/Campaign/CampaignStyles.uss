.campaign__root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 15, 30, 0.85);
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.campaign__panel {
    flex-direction: column;
    background-color: rgba(20, 25, 45, 0.95);
    border-color: rgb(0, 184, 148);
    border-width: 1px;
    border-radius: 4px;
    padding-top: 25px;
    padding-bottom: 25px;
    padding-left: 25px;
    padding-right: 25px;
    border-left-color: rgb(0, 255, 205);
    border-right-color: rgb(0, 255, 205);
    border-top-color: rgb(0, 255, 205);
    border-bottom-color: rgb(0, 255, 205);
    width: 100%;
    height: 100%;
    filter: filter(url("project://database/Assets/_Source/Art/Shaders/ChromaFilter.asset?fileID=11400000&guid=b9117f15d2285b04abdcc136ad8f4c80&type=2#ChromaFilter"));
}

.campaign__header {
    flex-direction: column;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom-color: rgba(0, 184, 148, 0.3);
    border-bottom-width: 1px;
    padding-right: 40px;
}

.campaign__container {
    flex-direction: row;
    margin-bottom: 25px;
    flex-grow: 1;
}

.campaign__info-section {
    flex-direction: column;
    background-color: rgba(15, 20, 35, 0.6);
    border-color: rgba(70, 170, 200, 0.2);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
}

.campaign__locations-section {
    margin-right: 20px;
    flex-shrink: 0;
}

.campaign__missions-section {
    flex-grow: 1;
    margin-right: 20px;
    margin-left: 0;
}

.campaign__section-title {
    font-size: 16px;
    color: rgb(0, 184, 148);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 1px;
    margin-bottom: 15px;
    padding-bottom: 8px;
    border-bottom-color: rgba(70, 170, 200, 0.2);
    border-bottom-width: 1px;
}

.campaign__missions-header {
    flex-direction: row;
    margin-bottom: 15px;
}

.campaign__loading-indicator {
    flex-direction: row;
    background-color: rgba(70, 170, 200, 0.2);
    border-color: rgb(70, 170, 200);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 20px;
}

.campaign__loading-text {
    font-size: 12px;
    color: rgb(180, 220, 240);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.campaign__locations-scrollview {
    flex-grow: 1;
}

.campaign__locations-tabs {
    flex-direction: column;
}

.campaign__location-tab {
    flex-direction: row;
    background-color: rgba(25, 30, 45, 0.8);
    border-color: rgb(70, 170, 200);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    padding-right: 12px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.campaign__location-tab:hover {
    background-color: rgba(70, 170, 200, 0.2);
    border-color: rgb(100, 200, 230);
}

.campaign__location-tab:active {
    background-color: rgba(70, 170, 200, 0.3);
    border-color: rgb(120, 220, 255);
}

.campaign__location-tab--selected {
    background-color: rgba(0, 184, 148, 0.3);
    border-color: rgb(0, 224, 178);
}

.campaign__location-tab--locked {
    opacity: 0.6;
    background-color: rgba(60, 70, 90, 0.5);
    border-color: rgb(80, 100, 120);
}

.campaign__location-tab--locked:hover {
    background-color: rgba(60, 70, 90, 0.6);
    border-color: rgb(100, 120, 140);
}

.campaign__location-name {
    font-size: 14px;
    color: rgb(180, 220, 210);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.campaign__location-status {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgb(70, 170, 200);
}

.campaign__location-status--completed {
    background-color: rgb(0, 184, 148);
}

.campaign__location-status--locked {
    background-color: rgb(120, 140, 160);
}

.campaign__missions-scrollview {
    flex-grow: 1;
}

.campaign__missions-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}

.campaign__mission-button {
    width: 80px;
    height: 80px;
    background-color: rgba(25, 30, 45, 0.8);
    border-color: rgb(70, 170, 200);
    border-width: 1px;
    border-radius: 3px;
    font-size: 20px;
    color: rgb(180, 220, 210);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    margin-right: 6px;
}

.campaign__mission-button:hover {
    background-color: rgba(70, 170, 200, 0.2);
    border-color: rgb(100, 200, 230);
}

.campaign__mission-button:active {
    background-color: rgba(70, 170, 200, 0.3);
    border-color: rgb(120, 220, 255);
}

.campaign__mission-button.campaign__mission-button--selected {
    background-color: rgba(70, 170, 200, 0.2);
    border-color: rgb(100, 200, 230);
}

.campaign__mission-button.campaign__mission-button--selected:hover {
    background-color: rgba(70, 170, 200, 0.2);
    border-color: rgb(100, 200, 230);
}

.campaign__mission-button.campaign__mission-button--selected:active {
    background-color: rgba(70, 170, 200, 0.2);
    border-color: rgb(100, 200, 230);
}

.campaign__mission-button--selected {
    border-width: 4px;
}

campaign__mission-button--selected:hover {
    border-width: 4px;
}

campaign__mission-button--selected:active {
    border-width: 4px;
}

.campaign__mission-button--locked {
    opacity: 0.5;
}

.campaign__mission-button.campaign__mission-button--locked:hover {
    opacity: 0.55;
}

.campaign__mission-button.campaign__mission-button--locked:active {
    opacity: 0.6;
}

.campaign__mission-button.campaign__mission-button--locked.campaign__mission-button--selected {
    opacity: 0.55;
}

.campaign__mission-button.campaign__mission-button--locked.campaign__mission-button--selected:hover {
    opacity: 0.55;
}

.campaign__mission-button.campaign__mission-button--locked.campaign__mission-button--selected:active {
    opacity: 0.55;
}

.campaign__mission-button--completed {
    background-color: rgba(46, 204, 113, 0.2);
    border-color: rgb(46, 204, 113);
}

.campaign__mission-button.campaign__mission-button--completed:hover {
    background-color: rgba(46, 204, 113, 0.3);
    border-color: rgb(46, 204, 113);
}

.campaign__mission-button.campaign__mission-button--completed:active {
    background-color: rgba(46, 204, 113, 0.4);
    border-color: rgb(46, 204, 113);
}

.campaign__mission-button--completed.campaign__mission-button--selected {
    background-color: rgba(46, 204, 113, 0.3);
    border-color: rgb(46, 204, 113);
}

.campaign__mission-button.campaign__mission-button--completed.campaign__mission-button--selected:hover {
    background-color: rgba(46, 204, 113, 0.3);
    border-color: rgb(46, 204, 113);
}

.campaign__mission-button.campaign__mission-button--completed.campaign__mission-button--selected:active {
    background-color: rgba(46, 204, 113, 0.3);
    border-color: rgb(46, 204, 113);
}

.campaign__mission-number {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.campaign__mission-details {
    flex-direction: column;
    flex-grow: 1;
    margin-bottom: 20px;
}

.campaign__mission-title {
    font-size: 18px;
    color: rgb(0, 184, 148);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 15px;
    padding-bottom: 8px;
    border-bottom-color: rgba(70, 170, 200, 0.2);
    border-bottom-width: 1px;
}

.campaign__mission-scrollview {
    flex-grow: 1;
    background-color: rgba(10, 15, 25, 0.4);
    border-color: rgba(70, 170, 200, 0.3);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    padding-right: 12px;
}

.campaign__mission-description {
    font-size: 14px;
    color: rgb(180, 220, 210);
    -unity-text-align: upper-left;
}

.campaign__mission-stats {
    flex-direction: column;
    padding-top: 15px;
    border-top-color: rgba(70, 170, 200, 0.2);
    border-top-width: 1px;
}

.campaign__stats-title {
    font-size: 14px;
    color: rgb(120, 200, 180);
    -unity-text-align: middle-left;
    margin-bottom: 10px;
}

.campaign__stars-container {
    flex-direction: row;
    margin-bottom: 15px;
}

.campaign__stat-star {
    width: 20px;
    height: 20px;
    background-color: rgb(255, 184, 0);
    border-radius: 50%;
    margin-left: 4px;
    margin-right: 4px;
}

.campaign__stat-star--empty {
    background-color: rgb(60, 70, 90);
    opacity: 0.5;
}

.campaign__mission-reward {
    flex-direction: column;
    padding-top: 15px;
    border-top-color: rgba(70, 170, 200, 0.2);
    border-top-width: 1px;
}

.campaign__reward-title {
    font-size: 14px;
    color: rgb(120, 200, 180);
    -unity-text-align: middle-left;
    margin-bottom: 10px;
}

.campaign__reward-icon {
    width: 32px;
    height: 32px;
    background-color: rgb(255, 184, 0);
    border-radius: 4px;
    margin-bottom: 8px;
}

.campaign__reward-text {
    font-size: 12px;
    color: rgb(180, 220, 210);
    -unity-text-align: middle-left;
}

.campaign__actions {
    flex-direction: row;
    padding-top: 25px;
    border-top-color: rgba(0, 184, 148, 0.3);
    border-top-width: 1px;
    justify-content: flex-end;
}

.campaign__button--primary:active {
    background-color: rgba(0, 184, 148, 0.5);
    border-color: rgb(0, 255, 200);
}

.campaign__button--primary:disabled {
    opacity: 0.5;
    background-color: rgba(60, 70, 90, 0.3);
    border-color: rgb(80, 100, 120);
    color: rgb(140, 160, 180);
}

.campaign__button--secondary {
    background-color: rgba(45, 52, 74, 0.8);
    border-color: rgb(70, 170, 200);
    color: rgb(180, 220, 240);
    margin-right: 20px;
}

.campaign__button--secondary:hover {
    background-color: rgba(70, 170, 200, 0.3);
    border-color: rgb(100, 200, 230);
}

.campaign__button--secondary:active {
    background-color: rgba(70, 170, 200, 0.4);
    border-color: rgb(120, 220, 255);
}

.campaign__loading-indicator {
}

.campaign__locations-scrollview > .unity-scroll-view__vertical-scroller,
.campaign__missions-scrollview > .unity-scroll-view__vertical-scroller,
.campaign__mission-scrollview > .unity-scroll-view__vertical-scroller {
    width: 6px;
}

.campaign__locations-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller,
.campaign__missions-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller,
.campaign__mission-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller {
    background-color: rgba(15, 20, 35, 0.3);
    border-radius: 3px;
}

.campaign__locations-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller > .unity-slider__dragger,
.campaign__missions-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller > .unity-slider__dragger,
.campaign__mission-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller > .unity-slider__dragger {
    background-color: rgba(70, 170, 200, 0.5);
    border-radius: 3px;
}

.campaign__locations-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller > .unity-slider__dragger:hover,
.campaign__missions-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller > .unity-slider__dragger:hover,
.campaign__mission-scrollview > .unity-scroll-view__vertical-scroller > .unity-scroller > .unity-slider__dragger:hover {
    background-color: rgba(100, 200, 230, 0.7);
}

.campaign__mission-stars {
    flex-direction: row;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.campaign__mission-star {
    width: 8px;
    height: 8px;
    margin-right: 3px;
    border-radius: 50%;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    color: var(--gold-border);
}
