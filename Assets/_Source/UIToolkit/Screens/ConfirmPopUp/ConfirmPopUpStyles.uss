
.confirm-popup__root {
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 12, 24, 0.82);
}

.confirm-popup__panel {
    width: 520px;
    min-height: 280px;
    height: auto;
    padding-top: 28px;
    padding-right: 28px;
    padding-bottom: 24px;
    padding-left: 28px;
    border-color: rgb(231, 76, 60);
    background-color: rgba(22, 18, 28, 0.96);
    -unity-background-image-tint-color: rgba(231, 76, 60, 0.08);
    justify-content: space-between;
    filter: filter(url("project://database/Assets/_Source/Art/Shaders/ChromaFilter.asset?fileID=11400000&guid=b9117f15d2285b04abdcc136ad8f4c80&type=2#ChromaFilter")) filter(url("project://database/Assets/_Source/Art/Shaders/GlitchFilter.asset?fileID=11400000&guid=af8001a8dfaf8a541bdcf0cc307629de&type=2#GlitchFilter"));
}

.confirm-popup__header {
    flex-direction: column;
    padding-right: 56px;
    margin-bottom: 20px;
}

.confirm-popup__title {
    color: rgb(255, 132, 116);
    margin-bottom: 10px;
}

.confirm-popup__title-accent {
    width: 100%;
    height: 3px;
    background-color: rgba(231, 76, 60, 0.85);
    border-radius: 2px;
}

.confirm-popup__body {
    flex-grow: 1;
    justify-content: center;
    background-color: rgba(10, 14, 24, 0.45);
    border-color: rgba(255, 132, 116, 0.18);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    margin-bottom: 24px;
}

.confirm-popup__message {
    color: rgb(232, 224, 226);
    font-size: 20px;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.confirm-popup__footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.confirm-popup__button {
    min-width: 170px;
    margin-bottom: 0;
}

#CancelButton {
    margin-right: 14px;
}
