<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Source/UIToolkit/Screens/MainMenu/MainMenuStyles.uss?fileID=7433441132597879392&amp;guid=b72b6d07834039643a1308ab69eea901&amp;type=3#MainMenuStyles"/>
    <ui:VisualElement class="menu__shader" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-color: rgb(0, 0, 0);"/>
    <ui:VisualElement name="RootWrapper" picking-mode="Ignore" class="main-menu__root">
        <ui:VisualElement name="ContentContainer" class="main-menu__content">
            <ui:VisualElement name="MenuPanel" style="flex-grow: 1; justify-content: center;">
                <ui:VisualElement name="HeaderSection" class="main-menu__header">
                    <ui:Label text="IT Cafe" class="main-menu__title" style="filter: filter();"/>
                    <ui:Label text="&#1053;&#1086; &#1077;&#1089;&#1090;&#1100; &#1085;&#1102;&#1072;&#1085;&#1089;&#1099;..." class="main-menu__subtitle"/>
                </ui:VisualElement>
                <ui:VisualElement name="MenuButtons" class="main-menu__buttons">
                    <ui:Button name="PlayButton" text="&#1048;&#1043;&#1056;&#1040;&#1058;&#1068;" class="cafe__control-button cafe__control-button--cyan"/>
                    <ui:Button name="SettingsButton" text="&#1053;&#1040;&#1057;&#1058;&#1056;&#1054;&#1049;&#1050;&#1048;" class="cafe__control-button cafe__control-button--blue"/>
                    <ui:Button name="ExitButton" text="&#1042;&#1067;&#1061;&#1054;&#1044;" class="cafe__control-button cafe__control-button--red"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="main-menu__footer">
            <ui:Label text="&#169; 2025 Emil Alekseev" class="main-menu__copyright"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
