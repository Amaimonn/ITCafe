Label {
}

.hud__root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding-top: 1px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    flex-grow: 1;
    filter: filter(url("project://database/Assets/_Source/Art/Shaders/CrtFilter.asset?fileID=11400000&guid=6922be53ede0c9b4c9a879c46efb1952&type=2#CrtFilter")) filter(url("project://database/Assets/_Source/Art/Shaders/HelmetDistortionFilter.asset?fileID=11400000&guid=9273d5e8cea48354683374b6bf5b714f&type=2#HelmetDistortionFilter"));
}

.hud__top-bar {
    flex-direction: row;
    align-items: center;
    height: 45px;
    background-color: rgba(12, 22, 45, 0.94);
    border-color: rgba(0, 184, 148, 0.5);
    border-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    width: 350px;
    align-self: center;
    position: relative;
    margin-bottom: 20px;
}

.hud__timer {
    font-size: 22px;
    color: rgb(0, 224, 178);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-items: center;
    position: relative;
    flex-grow: 1;
    text-shadow: 0 0 8px rgba(0, 224, 178, 0.5);
    letter-spacing: 1px;
}

.hud__points {
    font-size: 22px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.4);
    letter-spacing: 1px;
}

.hud__stats-panel {
    position: relative;
    width: 200px;
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 15px;
    padding-right: 15px;
    margin-left: 10px;
}

.hud__widget-title {
    font-size: 18px;
    color: rgb(0, 224, 178);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    margin-top: 4px;
    letter-spacing: 1px;
    border-bottom-color: rgba(0, 224, 178, 0.3);
    border-bottom-width: 1px;
    padding-bottom: 4px;
}

.hud__stat-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-bottom-color: rgba(100, 200, 255, 0.1);
    border-bottom-width: 1px;
}

.hud__stat-label {
    font-size: 16px;
    color: rgb(180, 220, 240);
    -unity-text-align: upper-left;
    opacity: 0.9;
    letter-spacing: 0.5px;
}

.hud__stat-value {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
    min-width: 40px;
}

.hud__orders-panel {
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 15px;
    padding-right: 15px;
    min-width: 170px;
    margin-right: 10px;
}

.hud__order {
    flex-direction: row;
    align-items: center;
    border-color: rgba(100, 200, 255, 0.3);
    border-width: 1px;
    border-radius: 6px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    justify-content: center;
    width: auto;
    position: relative;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

.hud__order-images {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    margin-left: 10px;
}

.hud__order-image {
    width: 32px;
    height: 32px;
    background-color: rgba(100, 200, 255, 0.2);
    border-color: rgba(100, 200, 255, 0.4);
    border-width: 1px;
    border-radius: 4px;
    margin-right: 0;
    margin-bottom: 0;
    margin-top: 0;
    margin-left: 0;
}

.hud__top-bar-item {
    flex-grow: 1;
    height: 100%;
    width: 50%;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

.hud__day {
    font-size: 22px;
    color: rgb(100, 200, 255);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.hud__bottom-panel {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    background-color: rgba(12, 22, 45, 0.95);
    border-color: rgba(0, 184, 148, 0.5);
    border-width: 1px;
    border-radius: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 15px;
    padding-right: 15px;
}

.hud__action-button {
    width: 55px;
    height: 55px;
    background-color: rgba(25, 40, 70, 0.8);
    border-color: rgba(100, 200, 255, 0.4);
    border-width: 1px;
    border-radius: 6px;
    margin-left: 6px;
    margin-right: 6px;
    position: relative;
}

.hud__action-button:hover {
    background-color: rgba(40, 60, 100, 0.9);
    border-color: rgba(0, 224, 178, 0.6);
}

.hud__action-icon {
    width: 35px;
    height: 35px;
    background-color: rgba(100, 200, 255, 0.3);
    border-color: rgba(100, 200, 255, 0.5);
    border-width: 1px;
    border-radius: 4px;
    align-self: center;
}

.hud__widget-panel {
    background-color: rgba(15, 25, 45, 0.94);
    border-color: rgba(0, 184, 148, 0.4);
    border-width: 1px;
    border-radius: 8px;
    border-left-color: rgb(0, 184, 148);
    border-right-color: rgb(0, 184, 148);
    border-top-color: rgb(0, 184, 148);
    border-bottom-color: rgb(0, 184, 148);
}
