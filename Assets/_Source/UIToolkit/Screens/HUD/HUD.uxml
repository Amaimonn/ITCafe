<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="OrderPreview" src="project://database/Assets/_Source/UIToolkit/Components/OrderPreview/OrderPreview.uxml?fileID=9197481963319205126&amp;guid=65f009e64710281458e0438bb57f3876&amp;type=3#OrderPreview"/>
    <Style src="project://database/Assets/_Source/UIToolkit/Screens/HUD/HUDStyles.uss?fileID=7433441132597879392&amp;guid=fa2de8381462ab242aca63d0f98fc09f&amp;type=3#HUDStyles"/>
    <Style src="project://database/Assets/_Source/UIToolkit/Screens/OrderCloudStyles.uss?fileID=7433441132597879392&amp;guid=3c10c99db55200040aa6f38ceb3ef33a&amp;type=3#OrderCloudStyles"/>
    <ui:VisualElement name="RootWrapper" picking-mode="Ignore" class="hud__root">
        <ui:VisualElement name="Header" style="flex-grow: 0; flex-direction: row; justify-content: center;">
            <ui:VisualElement name="OrdersPanel" class="hud__orders-panel">
                <ui:VisualElement name="OrdersContainer" class="hud__orders-container">
                    <ui:Instance template="OrderPreview" name="OrderPreview" style="flex-shrink: 0;"/>
                    <ui:Instance template="OrderPreview" name="OrderPreview" style="flex-shrink: 0;"/>
                    <ui:Instance template="OrderPreview" name="OrderPreview" style="flex-shrink: 0;"/>
                    <ui:Instance template="OrderPreview" name="OrderPreview" style="flex-shrink: 0;"/>
                    <ui:Instance template="OrderPreview" name="OrderPreview" style="flex-shrink: 0;"/>
                    <ui:Instance template="OrderPreview" name="OrderPreview" style="flex-shrink: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="TopBar" picking-mode="Ignore" class="hud__top-bar">
                <ui:VisualElement name="BarLeftItem" class="hud__top-bar-item"/>
                <ui:VisualElement style="flex-grow: 0; height: 100%; width: 4px; position: absolute; left: 50%; translate: -50% 0; background-color: rgb(143, 143, 143); display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Body" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="LeftSide" style="flex-grow: 1; align-items: flex-start; margin-top: 20px;">
                <ui:VisualElement class="hud__timer-bar">
                    <ui:Label text="- - : - -" name="Timer" class="hud__timer"/>
                </ui:VisualElement>
                <ui:VisualElement name="StatsPanel" class="hud__stats-panel hud__widget-panel">
                    <ui:Label class="hud__widget-title">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(294269993607168)"/>
                        </Bindings>
                    </ui:Label>
                    <ui:VisualElement name="OrderStat" class="hud__stat-item">
                        <ui:Label class="hud__stat-label" style="height: 20px;">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(294508557230080)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="0" name="OrderValue" class="hud__stat-value" style="-unity-text-outline-width: 0; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SatisfactionStat" class="hud__stat-item">
                        <ui:Label class="hud__stat-label">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(294567764025344)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="0" name="SatisfactionValue" class="hud__stat-value" style="color: rgb(79, 226, 18); -unity-text-outline-width: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="FailedStat" class="hud__stat-item">
                        <ui:Label class="hud__stat-label">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(294758160261120)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="0" name="FailedValue" class="hud__stat-value" style="color: rgb(226, 51, 18); -unity-text-outline-width: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="RatingStat" class="hud__stat-item" style="display: none;">
                        <ui:Label text="&#1056;&#1077;&#1081;&#1090;&#1080;&#1085;&#1075;:" class="hud__stat-label"/>
                        <ui:Label text="0.0" name="RatingValue" class="hud__stat-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ScoreStat" class="hud__stat-item">
                        <ui:Label class="hud__stat-label" style="font-size: 20px; color: rgb(97, 202, 255); -unity-font-style: bold;">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(18061521031659520)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="0" name="ScoreValue" class="hud__points"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="RightSide" style="flex-grow: 1; align-items: flex-end; margin-top: 20px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
