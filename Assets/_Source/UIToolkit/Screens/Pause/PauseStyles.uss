.pause__root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 15, 30, 0.85);
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
}

.pause__container {
    width: 450px;
    flex-direction: column;
    background-color: rgba(20, 25, 45, 0.95);
    border-color: rgb(0, 184, 148);
    border-width: 1px;
    border-radius: 4px;
    padding: 30px;
    position: relative;
    border-left-color: rgb(0, 255, 205);
    border-right-color: rgb(0, 255, 205);
    border-top-color: rgb(0, 255, 205);
    border-bottom-color: rgb(0, 255, 205);
    filter: filter(url("project://database/Assets/_Source/Art/Shaders/ChromaFilter.asset?fileID=11400000&guid=b9117f15d2285b04abdcc136ad8f4c80&type=2#ChromaFilter")) filter(url("project://database/Assets/_Source/Art/Shaders/GlitchFilter.asset?fileID=11400000&guid=af8001a8dfaf8a541bdcf0cc307629de&type=2#GlitchFilter"));
}

.pause__header {
    flex-direction: column;
    border-bottom-color: rgba(0, 184, 148, 0.3);
    border-bottom-width: 1px;
    padding-bottom: 30px;
    padding-right: 40px;
    margin-bottom: 30px;
}

.pause__stats-panel {
    flex-direction: column;
    background-color: rgba(15, 20, 35, 0.8);
    border-color: rgba(0, 184, 148, 0.2);
    border-width: 1px;
    border-radius: 3px;
    padding: 20px;
    margin-bottom: 30px;
}

.pause__stats-title {
    font-size: 11px;
    color: rgb(100, 180, 160);
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    margin-bottom: 15px;
    letter-spacing: 1px;
}

.pause__stats-grid {
    flex-direction: column;
}

.pause__stat-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.pause__stat-label {
    font-size: 13px;
    color: rgb(180, 220, 210);
    -unity-text-align: upper-left;
}

.pause__stat-value {
    font-size: 13px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-right;
    -unity-font-style: bold;
}

.pause__stat-value--rating {
    color: rgb(255, 215, 0);
}

.pause__actions {
    flex-direction: column;
    margin-bottom: 30px;
}

.pause__footer {
    flex-direction: column;
    align-items: center;
    border-top-color: rgba(0, 184, 148, 0.2);
    border-top-width: 1px;
    padding-top: 30px;
}

.pause__version {
    font-size: 14px;
    color: rgb(100, 150, 180);
    -unity-text-align: middle-center;
    margin-bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.pause__hint {
    font-size: 11px;
    color: rgb(120, 180, 200);
    -unity-text-align: middle-center;
}
