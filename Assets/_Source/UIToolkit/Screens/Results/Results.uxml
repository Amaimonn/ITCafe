                    <ui:Label text="15" name="OrdersTakenValue" class="results__stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement name="StatRow2" class="results__stat-row">
                    <ui:Label text="&#1042;&#1067;&#1055;&#1054;&#1051;&#1053;&#1045;&#1053;&#1054;_&#1059;&#1057;&#1055;&#1045;&#1064;&#1053;&#1054;:" class="results__stat-label"/>
                    <ui:Label text="12" name="OrdersCompletedValue" class="results__stat-value results__stat-value--success"/>
                </ui:VisualElement>
                <ui:VisualElement name="StatRow3" class="results__stat-row">
                    <ui:Label text="&#1057;&#1041;&#1054;&#1048;_&#1042;_&#1054;&#1041;&#1057;&#1051;&#1059;&#1046;&#1048;&#1042;&#1040;&#1053;&#1048;&#1048;:" class="results__stat-label"/>
                    <ui:Label text="3" name="OrdersFailedValue" class="results__stat-value results__stat-value--failed"/>
                </ui:VisualElement>
                <ui:VisualElement name="Divider" class="results__divider"/>
                <ui:VisualElement name="StatRow4" class="results__stat-row" style="display: none;">
                    <ui:Label text="&#1054;&#1041;&#1065;&#1048;&#1049;_&#1044;&#1054;&#1061;&#1054;&#1044;:" class="results__stat-label"/>
                    <ui:Label text="1 250" name="TotalIncomeValue" class="results__stat-value results__stat-value--income"/>
                </ui:VisualElement>
                <ui:VisualElement name="StatRow5" class="results__stat-row" style="display: none;">
                    <ui:Label text="&#1063;&#1040;&#1045;&#1042;&#1067;&#1045;:" class="results__stat-label"/>
                    <ui:Label text="180" name="TipsValue" class="results__stat-value results__stat-value--tips"/>
                </ui:VisualElement>
                <ui:VisualElement name="Divider2" class="results__divider"/>
                <ui:VisualElement name="StatRow6" class="results__stat-row results__stat-row--total" style="display: none;">
                    <ui:Label text="&#1048;&#1058;&#1054;&#1043;&#1054;_&#1047;&#1040;&#1056;&#1040;&#1041;&#1054;&#1058;&#1040;&#1053;&#1054;:" class="results__stat-label results__stat-label--total"/>
                    <ui:Label text="1 430" name="TotalValue" class="results__stat-value results__stat-value--total"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="BonusSection" class="results__bonus-section">
