<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Source/UIToolkit/Screens/Results/ResultsStyles.uss?fileID=7433441132597879392&amp;guid=b280a6aba7c9f5845b1f0dc49547865b&amp;type=3#ResultsStyles"/>
    <Style src="project://database/Assets/_Source/UIToolkit/SharedStyles/GlobalStyles.uss?fileID=7433441132597879392&amp;guid=8eda350a2ce341b0a6b97cc6e36588f0&amp;type=3#GlobalStyles"/>
    <ui:VisualElement name="RootWrapper" picking-mode="Ignore" class="results__root" style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 1; justify-content: center; filter: filter(url(&quot;project://database/Assets/_Source/Art/Shaders/ChromaFilter.asset?fileID=11400000&amp;guid=b9117f15d2285b04abdcc136ad8f4c80&amp;type=2#ChromaFilter&quot;)); align-items: center;">
            <ui:VisualElement name="ReceiptContainer" class="results__receipt">
                <ui:VisualElement name="ReceiptHeader" class="results__receipt-header">
                    <ui:Label text="IT_CAFE" class="results__cafe-name"/>
                    <ui:Label class="results__day-title">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25275563315814400)"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="#AF3242" name="BillCodeLabel" class="results__receipt-number"/>
                </ui:VisualElement>
                <ui:VisualElement name="StarsContainer" class="results__stars-container">
                    <ui:VisualElement name="StarContainer1" class="results__star-container">
                        <ui:VisualElement name="Star1" class="results__star results__star--filled"/>
                        <ui:Label text="000" name="StarBoundary1" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="results__star-boundary"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="StarContainer2" class="results__star-container">
                        <ui:VisualElement name="Star2" class="results__star results__star--filled" style="flex-grow: 1; margin-left: 0;"/>
                        <ui:Label text="000" name="StarBoundary2" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="results__star-boundary"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="StarContainer3" class="results__star-container">
                        <ui:VisualElement name="Star3" class="results__star results__star--filled" style="margin-left: 0;"/>
                        <ui:Label text="0000" name="StarBoundary3" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="results__star-boundary"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="StarContainer4" class="results__star-container">
                        <ui:VisualElement name="Star4" class="results__star results__star--empty" style="margin-left: 0;"/>
                        <ui:Label text="0000" name="StarBoundary4" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="results__star-boundary"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="StarContainer5" class="results__star-container">
                        <ui:VisualElement name="Star5" class="results__star results__star--empty"/>
                        <ui:Label text="0000" name="StarBoundary5" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="results__star-boundary"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="StatsSection" class="results__stats-section">
                    <ui:VisualElement name="OrdersRow1" class="results__stat-row">
                        <ui:Label class="results__stat-label">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25274601847119872)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="0" name="OrdersTakenValue" class="results__stat-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SuccessRow2" class="results__stat-row">
                        <ui:Label class="results__stat-label">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25274725625225216)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="0" name="OrdersCompletedValue" class="results__stat-value results__stat-value--success"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="FailRow3" class="results__stat-row">
                        <ui:Label class="results__stat-label">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25274772760813568)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="0" name="OrdersFailedValue" class="results__stat-value results__stat-value--failed"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Divider" class="results__divider"/>
                    <ui:VisualElement name="StatRow5" class="results__stat-row" style="display: none;">
                        <ui:Label text="&#1063;&#1040;&#1045;&#1042;&#1067;&#1045;:" class="results__stat-label"/>
                        <ui:Label text="180" name="TipsValue" class="results__stat-value results__stat-value--tips"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="TimeRow" class="results__bonus-row">
                        <ui:Label class="results__bonus-label">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25274893951033344)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="00:00" name="TimeWorkedValue" class="results__bonus-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="BonusRow" class="results__bonus-row" style="display: none;">
                        <ui:Label text="&#1041;&#1054;&#1053;&#1059;&#1057;_&#1047;&#1040;_&#1057;&#1050;&#1054;&#1056;&#1054;&#1057;&#1058;&#1068;:" class="results__bonus-label"/>
                        <ui:Label text="+50" name="SpeedBonusValue" class="results__bonus-value results__bonus-value--positive"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="RatingRow" class="results__bonus-row" style="display: none;">
                        <ui:Label text="&#1056;&#1045;&#1049;&#1058;&#1048;&#1053;&#1043;_&#1050;&#1040;&#1060;&#1045;:" class="results__bonus-label"/>
                        <ui:Label text="4.2/5.0" name="CafeRatingValue" class="results__bonus-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Divider2" class="results__divider"/>
                </ui:VisualElement>
                <ui:VisualElement name="BonusSection" class="results__bonus-section">
                    <ui:VisualElement name="IncomeRow" class="results__stat-row">
                        <ui:Label class="results__stat-label results__stat-label--total">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25274927870369792)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="0" name="PointsValue" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="results__stat-value results__stat-value--income"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ReceiptFooter" class="results__receipt-footer">
                    <ui:Label text="-------------------------------------------" class="results__divider-line"/>
                    <ui:Label class="results__next-day">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25275500195733504)"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ActionsContainer" class="results__actions">
                <ui:Button name="ContinueButton" text="&#1055;&#1056;&#1054;&#1044;&#1054;&#1051;&#1046;&#1048;&#1058;&#1068;_&#1056;&#1040;&#1041;&#1054;&#1058;&#1059;" class="results__button results__button--primary" style="display: none;"/>
                <ui:Button name="RestartButton" focusable="false" class="results__button results__button--secondary">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25275044950171648)"/>
                    </Bindings>
                </ui:Button>
                <ui:Button name="MenuButton" focusable="false" class="results__button results__button--primary" style="margin-left: 20px;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5d73c7b9fa74f5a4ca178ee718c45d24" entry="Id(25275067670716416)"/>
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
