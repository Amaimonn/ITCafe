.results__root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 15, 30, 0.85);
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
}

.results__receipt {
    width: 420px;
    flex-direction: column;
    background-color: rgba(20, 25, 45, 0.95);
    border-color: rgb(0, 184, 148);
    border-width: 1px;
    border-radius: 4px;
    padding: 30px;
    margin-bottom: 20px;
}

.results__receipt-header {
    flex-direction: column;
    align-items: center;
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom-color: rgba(0, 184, 148, 0.3);
    border-bottom-width: 1px;
}

.results__cafe-name {
    font-size: 26px;
    color: rgb(0, 184, 148);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    letter-spacing: 3px;
}

.results__receipt-number {
    font-size: 14px;
    color: rgb(120, 200, 180);
    -unity-text-align: middle-center;
    margin-bottom: 0;
    letter-spacing: 1px;
    padding-bottom: 0;
}

.results__day-title {
    font-size: 16px;
    color: rgb(200, 220, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 5px;
}

.results__stars-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: -4px;
    margin-top: 12px;
}

.results__star {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    margin: 0 6px;
    border-width: 2px;
    font-size: 100px;
    -unity-text-align: middle-center;
    border-top-left-radius: 0%;
    border-top-right-radius: 0%;
    border-bottom-right-radius: 0%;
    border-bottom-left-radius: 0%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(40, 60, 100);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 12px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.results__star--filled {
    border-color: rgb(255, 195, 0);
    color: rgb(255, 215, 0);
    -unity-text-outline-color: rgba(255, 230, 94, 0.6);
}

.results__star--empty {
    border-color: rgb(60, 100, 140);
    color: rgba(40, 60, 100, 0.6);
    -unity-text-outline-color: rgb(40, 60, 100);
}

.results__stats-section {
    flex-direction: column;
    margin-bottom: 20px;
}

.results__stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 8px 0;
    padding: 4px 0;
}

.results__stat-row--total {
    margin-top: 12px;
    padding-top: 12px;
    border-top-color: rgba(0, 184, 148, 0.3);
    border-top-width: 1px;
}

.results__stat-label {
    font-size: 16px;
    color: rgb(180, 220, 210);
    -unity-text-align: upper-left;
}

.results__stat-label--total {
    font-size: 15px;
    color: rgb(220, 240, 255);
    -unity-font-style: bold;
}

.results__stat-value {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-right;
    -unity-font-style: bold;
}

.results__stat-value--success {
    color: rgb(100, 255, 150);
}

.results__stat-value--failed {
    color: rgb(255, 100, 100);
}

.results__stat-value--income {
    color: rgb(255, 200, 100);
    font-size: 26px;
}

.results__stat-value--tips {
    color: rgb(200, 150, 255);
}

.results__stat-value--total {
    font-size: 16px;
    color: rgb(0, 255, 200);
}

.results__divider {
    height: 1px;
    background-color: rgba(0, 184, 148, 0.3);
    margin: 10px 0;
}

.results__bonus-section {
    flex-direction: column;
    margin-bottom: 20px;
    background-color: rgba(15, 25, 45, 0.8);
    border-color: rgba(70, 170, 200, 0.3);
    border-width: 1px;
    border-radius: 3px;
    padding: 15px;
}

.results__bonus-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 5px 0;
}

.results__bonus-label {
    font-size: 16px;
    color: rgb(150, 200, 220);
    -unity-text-align: upper-left;
}

.results__bonus-value {
    font-size: 16px;
    color: rgb(200, 230, 255);
    -unity-text-align: upper-right;
    -unity-font-style: bold;
}

.results__bonus-value--positive {
    color: rgb(100, 255, 150);
}

.results__receipt-footer {
    flex-direction: column;
    align-items: center;
    margin-top: 10px;
}

.results__thank-you {
    font-size: 13px;
    color: rgb(180, 220, 210);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.results__divider-line {
    font-size: 11px;
    color: rgba(0, 184, 148, 0.6);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    letter-spacing: 2px;
}

.results__next-day {
    font-size: 14px;
    color: rgb(150, 200, 220);
    -unity-text-align: middle-center;
}

.results__actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.results__button {
    min-width: 140px;
    height: 45px;
    background-color: transparent;
    border-color: rgb(0, 184, 148);
    border-width: 1px;
    border-radius: 3px;
    margin: 0;
    padding: 0 20px;
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(220, 240, 235);
}

.results__button--primary {
    background-color: rgba(0, 184, 148, 0.2);
    border-color: rgb(0, 184, 148);
}

.results__button--secondary {
    background-color: rgba(45, 52, 74, 0.8);
    border-color: rgb(70, 170, 200);
    color: rgb(180, 220, 240);
}

.results__button--primary:hover {
    background-color: rgba(0, 184, 148, 0.4);
    border-color: rgb(0, 224, 178);
}

.results__button--secondary:hover {
    background-color: rgba(70, 170, 200, 0.3);
    border-color: rgb(100, 200, 230);
}

.results__star-container {
    flex-grow: 1;
    align-items: center;
    max-width: 72px;
}

.results__star-boundary {
    color: rgb(255, 238, 144);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}
