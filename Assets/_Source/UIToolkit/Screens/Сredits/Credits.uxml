                    <ui:VisualElement name="Graphics" class="credits__entry">
                        <ui:Label class="credits__role">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:63329ac585b1d01458e19493fe6acc9f" entry="Id(8185065758720)"/>
