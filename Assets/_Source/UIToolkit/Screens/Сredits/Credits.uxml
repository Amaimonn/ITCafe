                    <ui:Label class="credits__section-title">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:63329ac585b1d01458e19493fe6acc9f" entry="Id(9314492416)"/>
                        </Bindings>
