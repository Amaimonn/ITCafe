.credits {
    flex-grow: 1;
    background-color: rgba(0, 10, 20, 0.95);
    border-width: 2px;
    border-color: var(--cyan-border);
    align-items: center;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.credits__header {
    padding: 24px 32px 16px 32px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.credits__title {
    font-size: 40px;
    -unity-text-align: middle-center;
    color: var(--cyan-border-active);
    letter-spacing: 4px;
    text-shadow: 0 0 8px var(--cyan-border);
}

.credits__subtitle {
    font-size: 14px;
    -unity-text-align: middle-center;
    color: var(--blue-color);
    letter-spacing: 2px;
    margin-top: 4px;
}

.credits__divider {
    height: 2px;
    background-color: var(--cyan-border);
    margin-top: 10px;
    margin-bottom: 10px;
    opacity: 0.5;
    max-width: 1080px;
    width: 1080px;
}

.credits__content {
    flex-direction: row;
    width: 800px;
    align-self: center;
    padding: 16px 32px;
    flex-grow: 1;
    justify-content: center;
}

.credits__column {
    flex-grow: 0;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 1;
    width: 300px;
}

.credits__section-title {
    font-size: 18px;
    color: var(--red-border-hover);
    letter-spacing: 2px;
    margin-top: 8px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--red-border);
    padding-bottom: 4px;
}

.credits__entry {
    margin-bottom: 10px;
}

.credits__entry--primary .credits__name {
    color: var(--gold-color);
}

.credits__role {
    font-size: 11px;
    color: var(--blue-border-hover);
    letter-spacing: 1px;
}

.credits__name {
    font-size: 16px;
    color: var(--blue-color);
    margin-left: 8px;
}

.credits__spacer {
    height: 18px;
}

.credits__icons {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
    margin-bottom: 16px;
}

.credits__icon-slot {
    width: 48px;
    height: 48px;
    margin-left: 8px;
    margin-right: 8px;
    border-width: 1px;
    border-color: var(--cyan-border);
    background-color: var(--cyan-bg);
}

.credits__thanks {
    font-size: 16px;
    -unity-text-align: middle-center;
    color: var(--gold-color);
    letter-spacing: 3px;
    margin-top: 12px;
}

.credits__footer {
    padding: 16px 32px 24px 32px;
    align-items: center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.credits__copyright {
    font-size: 10px;
    -unity-text-align: middle-center;
    color: var(--blue-border);
    margin-top: 10px;
    margin-bottom: 16px;
}

.credits__buttons {
    justify-content: center;
    align-items: center;
}

.credits__button {
    font-size: 14px;
    color: var(--cyan-border-active);
    background-color: var(--control-bg);
    border-width: 1px;
    border-color: var(--cyan-border);
    padding: 8px 24px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.credits__button:hover {
    background-color: var(--control-bg-hover);
    border-color: var(--cyan-border-hover);
}
