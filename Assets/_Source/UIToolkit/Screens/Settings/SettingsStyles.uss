.settings__root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 15, 30, 0.85);
    justify-content: center;
    align-items: center;
    padding: 30px 20px;
}

.settings__terminal {
    width: 500px;
    flex-direction: column;
    background-color: rgba(20, 25, 45, 0.95);
    border-color: rgb(0, 184, 148);
    border-width: 1px;
    border-radius: 4px;
    padding: 25px;
    position: relative;
    border-left-color: rgb(0, 255, 205);
    border-right-color: rgb(0, 255, 205);
    border-top-color: rgb(0, 255, 205);
    border-bottom-color: rgb(0, 255, 205);
}

.settings__close-button {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 28px;
    height: 28px;
    background-color: transparent;
    border-color: rgb(100, 120, 140);
    border-width: 1px;
    border-radius: 3px;
    color: rgb(160, 180, 200);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    padding-bottom: 2px;
}

.settings__close-button:hover {
    background-color: rgba(231, 76, 60, 0.2);
    border-color: rgb(231, 76, 60);
    color: rgb(255, 150, 140);
}

.settings__close-button:active {
    background-color: rgba(231, 76, 60, 0.3);
    border-color: rgb(255, 100, 80);
    color: rgb(255, 180, 170);
}

.settings__header {
    flex-direction: column;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom-color: rgba(0, 184, 148, 0.3);
    border-bottom-width: 1px;
    padding-right: 40px;
}

.settings__title {
    font-size: 22px;
    color: rgb(0, 184, 148);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.settings__subtitle {
    font-size: 11px;
    color: rgb(120, 200, 180);
    -unity-text-align: middle-left;
    letter-spacing: 1px;
}

.settings__sections {
    flex-direction: column;
    margin-bottom: 25px;
}

.settings__section {
    flex-direction: column;
    background-color: rgba(15, 20, 35, 0.6);
    border-color: rgba(70, 170, 200, 0.2);
    border-width: 1px;
    border-radius: 3px;
    padding: 20px;
}

.settings__bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 10px 0;
    padding: 8px 0;
    min-height: 36px;
    border-bottom-color: rgba(100, 120, 140, 0.1);
    border-bottom-width: 1px;
}

.settings__bar-label {
    font-size: 12px;
    color: rgb(180, 220, 210);
    -unity-text-align: middle-left;
    letter-spacing: 0.5px;
    flex-grow: 1;
    margin-right: 15px;
    min-width: 180px;
}

.settings__control {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    min-width: 200px;
}

.settings__slider {
    flex-grow: 1;
    min-width: 120px;
    max-width: 160px;
    height: 20px;
}

.settings__slider > .unity-base-slider__tracker {
    background-color: rgba(40, 60, 90, 0.8);
    border-color: rgb(70, 170, 200);
    border-width: 1px;
    border-radius: 3px;
    height: 6px;
}

.settings__slider > .unity-base-slider__dragger {
    background-color: rgb(0, 184, 148);
    border-color: rgb(0, 224, 178);
    border-width: 1px;
    border-radius: 50%;
    width: 16px;
    height: 16px;
}

.settings__slider > .unity-base-slider__dragger:hover {
    background-color: rgb(0, 224, 178);
    border-color: rgb(0, 255, 200);
}

.settings__slider > .unity-base-slider__dragger:active {
    background-color: rgb(0, 255, 200);
    border-color: rgb(100, 255, 230);
}

.settings__value {
    font-size: 12px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    min-width: 25px;
    -unity-text-align: middle-right;
    letter-spacing: 0.5px;
}

.settings__toggle {
    width: 40px;
    height: 20px;
    margin: 0;
    padding: 0;
}

.settings__toggle > .unity-toggle__checkmark {
    background-color: rgba(40, 60, 90, 0.8);
    border-color: rgb(70, 170, 200);
    border-width: 1px;
    border-radius: 10px;
    width: 40px;
    height: 20px;
}

.settings__toggle > .unity-toggle__checkmark {
    background-color: rgb(120, 150, 180);
    border-color: rgb(100, 130, 160);
    border-width: 1px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    margin-left: 1px;
    margin-top: 0;
}

.settings__toggle:checked > .unity-toggle__checkmark {
    background-color: rgba(0, 184, 148, 0.5);
    border-color: rgb(0, 224, 178);
}

.settings__toggle:checked > .unity-toggle__checkmark {
    background-color: rgb(0, 255, 200);
    border-color: rgb(0, 224, 178);
    margin-left: 19px;
}

.settings__actions {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
    padding-top: 20px;
    border-top-color: rgba(0, 184, 148, 0.3);
    border-top-width: 1px;
}

.settings__button {
    min-width: 180px;
    height: 40px;
    background-color: transparent;
    border-width: 1px;
    border-radius: 3px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.settings__button--primary {
    background-color: rgba(0, 184, 148, 0.2);
    border-color: rgb(0, 184, 148);
    color: rgb(220, 240, 235);
}

.settings__button--primary:hover {
    background-color: rgba(0, 184, 148, 0.4);
    border-color: rgb(0, 224, 178);
}

.settings__button--primary:active {
    background-color: rgba(0, 184, 148, 0.5);
    border-color: rgb(0, 255, 200);
}

.settings__button--secondary {
    background-color: rgba(45, 52, 74, 0.8);
    border-color: rgb(70, 170, 200);
    color: rgb(180, 220, 240);
}

.settings__button--secondary:hover {
    background-color: rgba(70, 170, 200, 0.3);
    border-color: rgb(100, 200, 230);
}

.settings__button--secondary:active {
    background-color: rgba(70, 170, 200, 0.4);
    border-color: rgb(120, 220, 255);
}

.settings__button:disabled {
    opacity: 0.5;
    background-color: rgba(60, 70, 90, 0.3);
    border-color: rgb(80, 100, 120);
    color: rgb(140, 160, 180);
}

.settings__dropdown {
    width: 120px;
}
