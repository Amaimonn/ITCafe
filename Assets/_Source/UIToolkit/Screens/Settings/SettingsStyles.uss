.settings__root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 15, 30, 0.78);
    padding: 30px 20px;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.settings__panel {
    flex-direction: column;
    padding: 25px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    max-width: 1920px;
    max-height: 1200px;
}

.settings__close-button {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 28px;
    height: 28px;
    background-color: transparent;
    border-color: rgb(100, 120, 140);
    border-width: 1px;
    border-radius: 3px;
    color: rgb(160, 180, 200);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    padding-bottom: 2px;
}

.settings__close-button:hover {
    background-color: rgba(231, 76, 60, 0.2);
    border-color: rgb(231, 76, 60);
    color: rgb(255, 150, 140);
}

.settings__close-button:active {
    background-color: rgba(231, 76, 60, 0.3);
    border-color: rgb(255, 100, 80);
    color: rgb(255, 180, 170);
}

.settings__header {
    flex-direction: column;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom-color: rgba(0, 184, 148, 0.3);
    border-bottom-width: 1px;
    padding-right: 40px;
}

.settings__title {
    font-size: 22px;
    color: rgb(0, 184, 148);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.settings__subtitle {
    font-size: 11px;
    color: rgb(120, 200, 180);
    -unity-text-align: middle-left;
    letter-spacing: 1px;
}

.settings__sections {
    flex-direction: column;
    flex-grow: 1;
    width: 600px;
}

.settings__section {
    flex-direction: column;
    flex-grow: 1;
}

.settings__section .unity-scroll-view__content-container {
    padding-left: 20px;
    padding-right: 12px;
}

.settings__control {
    align-items: stretch;
    justify-content: center;
    min-width: 180px;
}

.settings__actions {
    justify-content: center;
    align-items: center;
    padding-top: 20px;
    border-top-color: rgba(0, 184, 148, 0.3);
    border-top-width: 1px;
    flex-direction: row;
    flex-shrink: 0;
}

.settings__button {
    min-width: 180px;
    height: 40px;
    border-width: 1px;
    border-radius: 3px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.settings__button--primary {
    background-color: rgba(0, 184, 148, 0.2);
    border-color: rgb(0, 184, 148);
    color: rgb(220, 240, 235);
}

.settings__button--primary:hover {
    background-color: rgba(0, 184, 148, 0.4);
    border-color: rgb(0, 224, 178);
}

.settings__button--primary:active {
    background-color: rgba(0, 184, 148, 0.5);
    border-color: rgb(0, 255, 200);
}

.settings__button--secondary {
    background-color: rgba(45, 52, 74, 0.8);
    border-color: rgb(70, 170, 200);
    color: rgb(180, 220, 240);
}

.settings__button--secondary:hover {
    background-color: rgba(70, 170, 200, 0.3);
    border-color: rgb(100, 200, 230);
}

.settings__button--secondary:active {
    background-color: rgba(70, 170, 200, 0.4);
    border-color: rgb(120, 220, 255);
}

.settings__button:disabled {
    opacity: 0.5;
    background-color: rgba(60, 70, 90, 0.3);
    border-color: rgb(80, 100, 120);
    color: rgb(140, 160, 180);
}

.settings__widget-panel {
    background-color: rgba(15, 20, 35, 0.6);
    border-color: rgba(70, 170, 200, 0.2);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.settings__info-panel {
    flex-grow: 1;
    width: 400px;
    margin-left: 20px;
    background-image: url("project://database/Assets/_Source/Art/Images/cel_settings_icon.png?fileID=2800000&guid=72f6471196767924bbd46269f37c3bf6&type=3#cel_settings_icon");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(132, 165, 255, 0.04);
}

.settings__info-entry {
}

.settings__info-description {
    color: rgb(255, 255, 255);
    white-space: normal;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.settings__info-warning {
    color: rgb(255, 132, 34);
    white-space: normal;
}

.settings__info-title {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 24px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}
