  - m_Id: 13093060083712
    m_Localized: "\u0412\u044B\u0431\u0438\u0440\u0430\u0435\u0442 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u044F\u0437\u044B\u043A \u0434\u043B\u044F \u0432\u0441\u0435\u0433\u043E
      \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u0442\u0435\u043A\u0441\u0442\u0430,
      \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u043E\u0432, \u043C\u0435\u043D\u044E
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
      \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430. \r\n\r\n\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435
      \u044D\u0442\u043E\u0439 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442 \u0444\u0430\u0439\u043B\u044B
      \u043B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438 \u0438\u0433\u0440\u044B
      \u0434\u043B\u044F \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430 \u043D\u0430 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C
      \u044F\u0437\u044B\u043A\u0435, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F
      \u0438\u0433\u0440\u043E\u043A\u043E\u0432 \u043F\u043E \u0432\u0441\u0435\u043C\u0443
      \u043C\u0438\u0440\u0443."
