  - m_Id: 13115407335424
    m_Localized: "\u0420\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u0438 \u0444\u043E\u043D\u043E\u0432\u043E\u0439
      \u043C\u0443\u0437\u044B\u043A\u0438 \u0438 \u0441\u0430\u0443\u043D\u0434\u0442\u0440\u0435\u043A\u043E\u0432
      \u0432 \u0438\u0433\u0440\u0435. \r\n\r\n\u0411\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0435
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0434\u0435\u043B\u0430\u044E\u0442
      \u043C\u0443\u0437\u044B\u043A\u0443 \u0431\u043E\u043B\u0435\u0435 \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0439,
      \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044F \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
      \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0438 \u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B. \r\n\r\n\u0411\u043E\u043B\u0435\u0435
      \u043D\u0438\u0437\u043A\u0438\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0434\u0440\u0443\u0433\u0438\u043C
      \u0430\u0443\u0434\u0438\u043E\u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C,
      \u0442\u0430\u043A\u0438\u043C \u043A\u0430\u043A \u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0435
      \u044D\u0444\u0444\u0435\u043A\u0442\u044B, \u0432\u044B\u0434\u0435\u043B\u044F\u0442\u044C\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435. \r\n\r\n\u042D\u0442\u0430 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430
      \u043D\u0435 \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C
      \u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
