    m_Localized: "\u0420\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u043E\u0431\u0449\u0443\u044E
      \u044F\u0440\u043A\u043E\u0441\u0442\u044C \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u0438\u0433\u0440\u044B, \u0434\u0435\u043B\u0430\u044F \u0441\u0446\u0435\u043D\u044B
      \u044F\u0440\u0447\u0435 \u0438\u043B\u0438 \u0442\u0435\u043C\u043D\u0435\u0435
      \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0431\u0430\u043B\u0430\u043D\u0441\u0430
      \u0446\u0432\u0435\u0442\u043E\u0432. \r\n\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u044D\u0442\u0443 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0443,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C
      \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u0443\u044E \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C
      \u043A\u0430\u043A \u0432 \u0445\u043E\u0440\u043E\u0448\u043E \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u044B\u0445,
      \u0442\u0430\u043A \u0438 \u0432 \u0437\u0430\u0442\u0435\u043C\u043D\u0451\u043D\u043D\u044B\u0445
      \u0443\u0433\u043E\u043B\u043A\u0430\u0445 \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E
      \u043C\u0438\u0440\u0430, \u0438\u043B\u0438 \u0434\u043B\u044F \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0438
      \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438 \u043F\u043E\u0434 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435
      \u0432 \u0432\u0430\u0448\u0435\u043C \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12717963476992
    m_Localized: "\u0421\u0432\u0435\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12738653978624
    m_Localized: "\u0418\u043C\u0438\u0442\u0438\u0440\u0443\u0435\u0442, \u043A\u0430\u043A
      \u044F\u0440\u043A\u0438\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438
      \u0441\u0432\u0435\u0442\u0430 \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0435 \u043E\u0431\u043B\u0430\u0441\u0442\u0438,
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u044F \u044D\u0444\u0444\u0435\u043A\u0442
      \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u044F \u0432\u043E\u043A\u0440\u0443\u0433
      \u0442\u0430\u043A\u0438\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432,
      \u043A\u0430\u043A \u043B\u0430\u043C\u043F\u044B \u0438\u043B\u0438 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442. \r\n\r\n\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u0440\u0435\u0430\u043B\u0438\u0437\u043C\u0430 \u0438 \u0433\u043B\u0443\u0431\u0438\u043D\u044B
      \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u044B\u043C
      \u0441\u0446\u0435\u043D\u0430\u043C, \u0434\u0435\u043B\u0430\u044F \u0438\u0445
      \u0431\u043E\u043B\u0435\u0435 \u044F\u0440\u043A\u0438\u043C\u0438 \u0438
      \u043D\u0435\u0437\u0435\u043C\u043D\u044B\u043C\u0438. \r\n\r\n\u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u044D\u0444\u0444\u0435\u043A\u0442\u0430 \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043C\u0435\u043D\u0435\u0435
      \u0441\u0442\u0438\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0438 \u0441\u043D\u0438\u0436\u0430\u0435\u0442
      \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443 \u043D\u0430 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440, \u0447\u0442\u043E
      \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12663060037632
    m_Localized: "\u0421\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u0435"
