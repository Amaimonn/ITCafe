  - m_Id: 13407217647616
    m_Localized: "\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043C\u044B\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 13445767495680
    m_Localized: "\u0420\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u043E\u0431\u0437\u043E\u0440\u0430
      \u043F\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u043C\u044B\u0448\u0438.
      \r\n\r\n\u0411\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0435
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0434\u0435\u043B\u0430\u044E\u0442
      \u043A\u0430\u043C\u0435\u0440\u0443 \u0431\u043E\u043B\u0435\u0435 \u043E\u0442\u0437\u044B\u0432\u0447\u0438\u0432\u043E\u0439
      \u043D\u0430 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043C\u044B\u0448\u0438,
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F,
      \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043A\u0430\u043A \u0431\u043E\u043B\u0435\u0435
      \u043D\u0438\u0437\u043A\u0438\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u0431\u043E\u043B\u0435\u0435
      \u043F\u043B\u0430\u0432\u043D\u043E\u0435 \u0438 \u0442\u043E\u0447\u043D\u043E\u0435
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435. \r\n\r\n\u042D\u0442\u0430
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u043F\u043E\u043B\u0435\u0437\u043D\u0430 \u0434\u043B\u044F \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u0438
      \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u043E\u043F\u044B\u0442\u0430
      \u043F\u043E\u0434 \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0441\u0442\u0438\u043B\u044C \u0438\u0433\u0440\u044B \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 13186681143296
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13126841008128
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0440\u0435\u043D\u0434\u0435\u0440\u0438\u043D\u0433\u0430
      \u0434\u043B\u044F \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u043E\u043A\u043D\u0430
      \u0438\u043B\u0438 \u043F\u043E\u043B\u043D\u043E\u044D\u043A\u0440\u0430\u043D\u043D\u043E\u0433\u043E
      \u0440\u0435\u0436\u0438\u043C\u0430. \r\n\r\n\u0411\u043E\u043B\u0435\u0435
      \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u0431\u043E\u043B\u0435\u0435
      \u0447\u0435\u0442\u043A\u0438\u0435 \u0438 \u0434\u0435\u0442\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0441 \u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u044F\u0441\u043D\u043E\u0441\u0442\u044C\u044E \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u044D\u043A\u0440\u0430\u043D\u0430\u0445, \u043D\u043E \u043C\u043E\u0433\u0443\u0442
      \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435
      \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u043E\u0442 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F, \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E
      \u0441\u043D\u0438\u0436\u0430\u044F \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043D\u0430 \u0441\u043B\u0430\u0431\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445.
      \r\n\r\n\u0411\u043E\u043B\u0435\u0435 \u043D\u0438\u0437\u043A\u043E\u0435
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u043A\u0430\u0434\u0440\u043E\u0432
      \u0438 \u043F\u043B\u0430\u0432\u043D\u043E\u0441\u0442\u044C \u0437\u0430
      \u0441\u0447\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u0438 \u0440\u0435\u0437\u043A\u043E\u0441\u0442\u0438
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F. \r\n\r\n\u042D\u0442\u0430
      \u043E\u043F\u0446\u0438\u044F \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
      \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u043E\u0431\u0449\u0435\u0435
      \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E
      \u0438 \u0434\u043E\u043B\u0436\u043D\u0430 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0430
      \u0434\u043B\u044F \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0445
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432.\n\n\u0417\u043D\u0430\u0447\u0435\u043D\u0438\u0435
      \u043F\u043E \u0443\u043C\u0430\u043B\u0447\u0430\u043D\u0438\u044E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 13174010150912
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0431\u0449\u0438\u043C
      \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0434\u0435\u0442\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432
      \u0432 \u0438\u0433\u0440\u0435.\r\n\r\n\u041F\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
      \u0432\u0430\u0440\u044C\u0438\u0440\u0443\u044E\u0442\u0441\u044F \u043E\u0442
      \u041D\u0438\u0437\u043A\u043E\u0433\u043E \u0434\u043E \u0423\u043B\u044C\u0442\u0440\u0430,
      \u0433\u0434\u0435 \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0435
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u044E\u0442
      \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438,
      \u0442\u0430\u043A\u0438\u0435 \u043A\u0430\u043A \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u0435
      \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B, \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435,
      \u0442\u0435\u043D\u0438 \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u044B
      \u0447\u0430\u0441\u0442\u0438\u0446, \u0434\u043B\u044F \u0431\u043E\u043B\u0435\u0435
      \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0433\u043E \u0438
      \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u043E\u043F\u044B\u0442\u0430. \r\n\r\n\u0411\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0435
      \u0443\u0440\u043E\u0432\u043D\u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443
      \u043D\u0430 GPU \u0438 CPU, \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043A \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044E
      \u0447\u0430\u0441\u0442\u043E\u0442\u044B \u043A\u0430\u0434\u0440\u043E\u0432
      \u043D\u0430 \u043C\u0435\u043D\u0435\u0435 \u043C\u043E\u0449\u043D\u043E\u043C
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0438. \r\n\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u044D\u0442\u0443 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0443 \u0434\u043B\u044F
      \u0431\u0430\u043B\u0430\u043D\u0441\u0430 \u043C\u0435\u0436\u0434\u0443 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u043C
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E\u043C \u0438 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439 \u0432\u0430\u0448\u0435\u0439
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 13161708257280
    m_Localized: "\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0433\u0440\u0430\u0444\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 13138207571968
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13150895341568
    m_Localized: "\u0412\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0438\u043B\u0438
      \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B,
      \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u043C\u044B\u0435 \u043F\u043E\u0441\u043B\u0435
      \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u0440\u0435\u043D\u0434\u0435\u0440\u0438\u043D\u0433\u0430.\r\n\r\n\u042D\u0442\u0438
      \u044D\u0444\u0444\u0435\u043A\u0442\u044B \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442
      \u043A\u0438\u043D\u0435\u043C\u0430\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0438 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443
      \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u043C\u0438\u0440\u0430,
      \u0434\u0435\u043B\u0430\u044F \u0441\u0446\u0435\u043D\u044B \u0431\u043E\u043B\u0435\u0435
      \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u043D\u044B\u043C\u0438 \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438.
      \r\n\r\n\u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043F\u043E\u0441\u0442\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u043C\u043E\u0436\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043D\u0430 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0438
      \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F
      \u0437\u0430 \u0441\u0447\u0435\u0442 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F
      \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438, \u0445\u043E\u0442\u044F
      \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u043A \u043C\u0435\u043D\u0435\u0435 \u044F\u0440\u043A\u043E\u043C\u0443
      \u0438\u043B\u0438 \u0441\u0442\u0438\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u043C\u0443
      \u0432\u0438\u0434\u0443."
    m_Metadata:
