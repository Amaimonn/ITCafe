  - m_Id: 13009245306880
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442 \u0442\u043E\u043D\u043A\u0438\u0439
      \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u0448\u0443\u043C
      \u0434\u043B\u044F \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u0438 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B
      \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u043F\u043B\u0435\u043D\u043A\u0438,
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F \u0432\u0438\u043D\u0442\u0430\u0436\u043D\u044B\u0439
      \u0438\u043B\u0438 \u043A\u0438\u043D\u0435\u043C\u0430\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043E\u0442\u0442\u0435\u043D\u043E\u043A.\r\n\r\n\u042D\u0442\u043E\u0442
      \u044D\u0444\u0444\u0435\u043A\u0442 \u043C\u043E\u0436\u0435\u0442 \u0443\u0441\u0438\u043B\u0438\u0442\u044C
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u043E\u0435 \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0435,
      \u043D\u043E \u0441\u043B\u0435\u0433\u043A\u0430 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043C\u0435\u043B\u043A\u0438\u0435 \u0434\u0435\u0442\u0430\u043B\u0438.
      \r\n\r\n\u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
      \u043A \u0431\u043E\u043B\u0435\u0435 \u0447\u0438\u0441\u0442\u043E\u043C\u0443,
      \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u043C\u0443 \u0432\u0438\u0434\u0443
      \u0438 \u043C\u043E\u0436\u0435\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0437\u0430\u0441\u0447\u0451\u0442 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F
      \u0440\u0430\u0441\u0447\u0435\u0442\u043E\u0432 \u043F\u043E\u0441\u0442\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438."
