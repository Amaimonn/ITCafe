    m_Localized: "\u0425\u0440\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0430\u0431\u0435\u0440\u0440\u0430\u0446\u0438\u044F"
