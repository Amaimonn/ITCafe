  - m_Id: 13152012823822336
    m_Localized: "\u0425\u0440\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0430\u0431\u0435\u0440\u0440\u0430\u0446\u0438\u044F \u2013 \u044D\u0442\u043E
      \u044D\u0444\u0444\u0435\u043A\u0442 \u043F\u043E\u0441\u0442-\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438,
      \u0438\u043C\u0438\u0442\u0438\u0440\u0443\u044E\u0449\u0438\u0439 \u0446\u0432\u0435\u0442\u043E\u0432\u043E\u0435
      \u0438\u0441\u043A\u0430\u0436\u0435\u043D\u0438\u0435, \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0449\u0435\u0435
      \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u0430\u0445
      \u043A\u0430\u043C\u0435\u0440. \r\n\r\n\u042D\u0444\u0444\u0435\u043A\u0442
      \u0441\u043E\u0437\u0434\u0430\u0435\u0442 \u043A\u0440\u0430\u0441\u043D\u044B\u0435/\u0441\u0438\u043D\u0438\u0435
      \u0438\u043B\u0438 \u0437\u0435\u043B\u0435\u043D\u044B\u0435/\u043F\u0443\u0440\u043F\u0443\u0440\u043D\u044B\u0435
      \u043E\u0440\u0435\u043E\u043B\u044B \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u044B\u0445
      \u0433\u0440\u0430\u043D\u0438\u0446 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432.\r\n\r\n\r\n\u0412\u041A\u041B.:
      \u0418\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
      \u0446\u0432\u0435\u0442\u043D\u044B\u0435 \u043E\u0440\u0435\u043E\u043B\u044B,
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043F\u043E \u043A\u0440\u0430\u044F\u043C
      \u044D\u043A\u0440\u0430\u043D\u0430 \u0438 \u043D\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0430\u0445
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432.\r\n\r\n\u0412\u042B\u041A\u041B.:
      \u0418\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
      \u0447\u0435\u0442\u043A\u0438\u043C, \u0431\u0435\u0437 \u0446\u0432\u0435\u0442\u043E\u0432\u044B\u0445
      \u0438\u0441\u043A\u0430\u0436\u0435\u043D\u0438\u0439.\r\n"
