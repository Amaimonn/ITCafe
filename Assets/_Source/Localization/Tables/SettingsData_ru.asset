    m_Localized: "\n\u0414\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u044D\u0444\u0444\u0435\u043A\u0442\u0430
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
