  m_TableData:
  - m_Id: 5380374528
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043F\u043B\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35214458880
    m_Localized: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u043E\u0434\u0440\u0430\u0431\u043E\u0442\u043A\u0430.
      \u041F\u0440\u043E\u0441\u0442\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430.
      \u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435,
      \u0442\u0430\u043A \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0434\u043E
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043C\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 3952459513856
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u0444\u0438\u043A\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 4102875643904
    m_Localized: "\u041E\u0447\u0435\u0440\u0435\u0434\u044C \u0440\u0430\u0441\u0442\u0451\u0442,
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0435\u0442. \u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0432\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043F\u0440\u044F\u043C\u043E
      \u0432 \u043F\u0440\u043E\u0434\u0430\u043A\u0448\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 4145938563072
    m_Localized: "\u041D\u0435 \u043F\u043E \u0422\u0417"
    m_Metadata:
      m_Items: []
  - m_Id: 4189198614528
    m_Localized: "\u0417\u0430\u043A\u0430\u0437\u044B \u0437\u0432\u0443\u0447\u0430\u0442
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0432\u043E.
      \u0422\u044B \u0434\u0435\u043B\u0430\u0435\u0448\u044C \u0432\u0438\u0434,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u043F\u043E\u043D\u044F\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 4248065671168
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 4291594158080
    m_Localized: "\u0422\u0435\u043C\u043F \u0440\u0430\u0441\u0442\u0451\u0442,
      \u043E\u0448\u0438\u0431\u043E\u043A \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435. \u041F\u0430\u0443\u0437\u0430 \u043D\u0435
      \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4466316279808
    m_Localized: "Legacy \u043F\u0440\u043E\u0446\u0435\u0441\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 4516798922752
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0442\u0430\u043A \u043F\u0440\u0438\u043D\u044F\u0442\u043E.
      \u041F\u043E\u0447\u0435\u043C\u0443 - \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u043F\u043E\u043C\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 4605374234624
    m_Localized: "\u041A\u043E\u043D\u0435\u0446 \u0441\u043C\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 4632419106816
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C,
      \u0430 \u0442\u044B \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4720264609792
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u043A\u0448\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 4763818262528
    m_Localized: "\u0423\u0447\u0435\u0431\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C
      \u043E\u0442\u043A\u043B\u044E\u0447\u0451\u043D. \u041E\u0448\u0438\u0431\u043A\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4811566219264
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u043A\u0430\u0437\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 4863776915456
    m_Localized: "\u041F\u043E\u0442\u043E\u043A \u0441\u0442\u0430\u0431\u0438\u043B\u0435\u043D
      \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u0435\u043D. \u0422\u044B
      \u0434\u043E\u043B\u0436\u0435\u043D \u0443\u0441\u043F\u0435\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5230472331264
    m_Localized: "\u0413\u0434\u0435-\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441
      \u0434\u0430\u0451\u0442 \u0441\u0431\u043E\u0439. \u041D\u0430\u0439\u0434\u0438
      \u0441\u043B\u0430\u0431\u043E\u0435 \u0437\u0432\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 5200487251968
    m_Localized: "\u0423\u0437\u043A\u043E\u0435 \u043C\u0435\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5449859596288
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0439
      \u0444\u0430\u043A\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 5483762155520
    m_Localized: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u043E. \u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
      \u0432 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5534806835200
    m_Localized: "\u041F\u043E\u0434 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 5564347318272
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u0430 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u043D\u0430 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5600573521920
    m_Localized: "\u0421\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u043B\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 5629598105600
    m_Localized: "\u0412\u0441\u0451 \u0438\u0434\u0451\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0433\u043B\u0430\u0434\u043A\u043E. \u042D\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
